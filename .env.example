DATABASE_URL=postgresql+psycopg://arqqa:arqqa_dev_password@localhost:5432/arqqa
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DEFAULT_MODEL=models/gemini-2.5-flash
APP_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:3000
DASHBOARD_PASSWORD=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAX_UPLOAD_MB=20
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
RETRIEVAL_FETCH_K=40
MIN_SIMILARITY=0.3
MMR_LAMBDA=0.65
ENABLE_RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_MULTI_QUERY=false
MULTI_QUERY_COUNT=2
RERANK_CANDIDATES=12
NEIGHBOR_WINDOW=1
MAX_CONTEXT_CHARS=9000
